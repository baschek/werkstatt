 "cases": [
  {
   "name": "prefix, synonyms and category rank",
   "query": "akku",
   "expect": {
    "ordered": [
     "i-akkupack",
     "i-lipo",
     "i-akkuschrauber"
    ]
   }
  },
  {
   "name": "synonym Batterie finds Akku and LiPo",
   "query": "batterie",
   "expect": {
    "contains": [
     "i-akkupack",
     "i-lipo"
    ],
    "absent": [
     "i-m4"
    ]
   }
  },
  {
   "name": "umlaut written as ae",
   "query": "fraeser",
   "expect": {
    "ordered": [
     "i-fraeser",
     "m-fraese"
    ]
   }
  },
  {
   "name": "umlaut typed",
   "query": "Fräser",
   "expect": {
    "first": "i-fraeser"
   }
  },
  {
   "name": "multi-word synonym end mill",
   "query": "end mill",
   "expect": {
    "first": "i-fraeser"
   }
  },
  {
   "name": "place code is exact",
   "query": "R2-K5",
   "expect": {
    "ordered": [
     "p-r2k5",
     "i-fraeser"
    ],
    "absent": [
     "p-r2k6",
     "p-r2"
    ]
   }
  },
  {
   "name": "place code without dash",
   "query": "r2k5",
   "expect": {
    "first": "p-r2k5"
   }
  },
  {
   "name": "box name finds the box and its contents",
   "query": "kiste k6",
   "expect": {
    "ordered": [
     "p-r2k6"
    ],
    "contains": [
     "i-lipo",
     "i-multimeter"
    ],
    "absent": [
     "i-fraeser"
    ]
   }
  },
  {
   "name": "typo with one missing letter",
   "query": "akkuschruber",
   "expect": {
    "exactly": [
     "i-akkuschrauber"
    ]
   }
  },
  {
   "name": "typo in a long word",
   "query": "multimetr",
   "expect": {
    "first": "i-multimeter"
   }
  },
  {
   "name": "stop words are dropped",
   "query": "wo ist der Lötkolben",
   "expect": {
    "first": "i-loetkolben"
   }
  },
  {
   "name": "upper case and missing umlaut",
   "query": "LOTKOLBEN",
   "expect": {
    "first": "i-loetkolben"
   }
  },
  {
   "name": "substring of a compound word",
   "query": "schraube",
   "expect": {
    "contains": [
     "i-m3",
     "i-m4"
    ],
    "absent": [
     "i-lipo",
     "i-pla"
    ]
   }
  },
  {
   "name": "category synonym",
   "query": "maschine",
   "expect": {
    "contains": [
     "i-akkuschrauber"
    ],
    "absent": [
     "i-fraeser"
    ]
   }
  },
  {
   "name": "category synonym reaches items of the category",
   "query": "energiespeicher",
   "expect": {
    "contains": [
     "i-akkupack",
     "i-lipo"
    ],
    "absent": [
     "i-m4",
     "i-fraeser"
    ]
   }
  },
  {
   "name": "all words must match",
   "query": "makita akkuschrauber",
   "expect": {
    "first": "i-akkuschrauber",
    "exactly": [
     "i-akkuschrauber"
    ]
   }
  },
  {
   "name": "spec value",
   "query": "2200",
   "expect": {
    "first": "i-lipo"
   }
  },
  {
