   "filters": {
    "status": "inbox"
   },
   "expect": {
    "exactly": [
     "i-loetkolben"
    ]
   }
  },
  {
   "name": "place filter includes everything below",
   "query": "",
   "filters": {
    "place": "R2"
   },
   "expect": {
    "contains": [
     "i-lipo",
     "i-fraeser",
     "i-pla",
     "p-r2k5",
     "p-r2k6"
    ],
    "absent": [
     "p-r2",
     "i-m4",
     "i-akkupack"
    ]
   }
  },
  {
   "name": "place filter by path name and query",
   "query": "schrauben",
   "filters": {
    "place": "Schublade Schrauben"
   },
   "expect": {
    "contains": [
     "i-m3",
     "i-m4"
    ],
    "absent": [
     "i-akkuschrauber"
    ]
   }
  },
  {
   "name": "category filter includes sub-categories",
