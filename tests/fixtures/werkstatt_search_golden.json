     "i-akkuschrauber"
    ]
   }
  },
  {
   "name": "tag filter on items",
   "query": "",
   "filters": {
    "tag": "Makita"
   },
   "expect": {
    "exactly": [
     "i-akkuschrauber"
    ]
   }
  },
  {
   "name": "tag filter on places",
   "query": "",
   "filters": {
    "tag": "elektronik"
   },
   "expect": {
    "exactly": [
     "p-r2k6"
    ]
   }
  },
  {
   "name": "unknown place filter",
   "query": "",
   "filters": {
    "place": "Nirgendwo"
   },
   "expect": {
    "empty": true,
    "unresolved": [
     "place"
    ]
   }
  },
  {
   "name": "unknown category filter",
   "query": "akku",
   "filters": {
    "category": "Gibtsnicht"
   },
   "expect": {
    "empty": true,
    "unresolved": [
     "category"
    ]
   }
  },
  {
   "name": "sz and compound spelling",
   "query": "heißklebe",
   "expect": {
    "first": "i-klebepistole"
   }
  }
 ]
